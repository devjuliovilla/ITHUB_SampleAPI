{
  "info": {
    "_postman_id": "9655cc58-7b4e-3555-8422-c8f47b6811b4",
    "name": "ITHUB_SampleAPI",
    "description": "Generada con rest2postman a partir de archivos .rest/.http.\n\n1. Importa también el environment `ITHUB_SampleAPI (local)`, selecciónalo y llena: `email`, `password`, `adminPassword`.\n2. Ejecuta primero: \"Login\", \"Login as administrator\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "71aafe94-b8a8-3729-a284-dacaee7e2bd9",
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generado por rest2postman: guarda datos de la respuesta para usarlos en los demás requests.",
              "{",
              "    const responseText = pm.response.text();",
              "    let responseBody = responseText;",
              "    try { responseBody = JSON.parse(responseText); } catch (e) { }",
              "    function pick(obj, path) { return path.reduce((o, k) => (o === null || o === undefined) ? undefined : o[k], obj); }",
              "    function save(name, value) {",
              "        if (value !== null && typeof value === 'object') { value = JSON.stringify(value); }",
              "        pm.collectionVariables.set(name, value);",
              "        if (pm.environment.has(name)) { pm.environment.set(name, value); }",
              "        pm.test('Variable ' + name + ' guardada', () => pm.expect(value, name).to.not.be.oneOf([undefined, null, '']));",
              "    }",
              "    save(\"token\", pick(responseBody, [\"accessToken\"]));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{apiBaseUrl}}/api/auth/login",
          "host": [
            "{{apiBaseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Ejecuta este request primero. Guarda en variables de la colección: `token`.\n\nOrigen: `Statuses/Get-List.rest` (línea 8)"
      },
      "response": []
    },
    {
