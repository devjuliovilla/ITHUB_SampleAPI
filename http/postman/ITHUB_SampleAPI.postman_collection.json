          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generado por rest2postman: guarda datos de la respuesta para usarlos en los demás requests.",
              "{",
              "    const responseText = pm.response.text();",
              "    let responseBody = responseText;",
              "    try { responseBody = JSON.parse(responseText); } catch (e) { }",
              "    function pick(obj, path) { return path.reduce((o, k) => (o === null || o === undefined) ? undefined : o[k], obj); }",
              "    function save(name, value) {",
              "        if (value !== null && typeof value === 'object') { value = JSON.stringify(value); }",
              "        pm.collectionVariables.set(name, value);",
              "        if (pm.environment.has(name)) { pm.environment.set(name, value); }",
              "        pm.test('Variable ' + name + ' guardada', () => pm.expect(value, name).to.not.be.oneOf([undefined, null, '']));",
              "    }",
              "    save(\"login_accessToken\", pick(responseBody, [\"accessToken\"]));",
              "}"
            ]
          }
        }
