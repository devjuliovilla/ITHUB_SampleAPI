<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ithub-sampleapi-local-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ITHUB.SampleAPI.Application\ITHUB.SampleAPI.Application.csproj" />
    <ProjectReference Include="..\ITHUB.SampleAPI.Common\ITHUB.SampleAPI.Common.csproj" />
    <ProjectReference Include="..\ITHUB.SampleAPI.Persistence\ITHUB.SampleAPI.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
